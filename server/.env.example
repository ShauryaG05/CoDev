# ==============================================================================
# CoDev Server Environment Configuration Template
# ==============================================================================

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (set local or MongoDB Atlas URL)
MONGO_URI=mongodb://localhost:27017/codev
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/codev?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=replace_with_jwt_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional for single instance prototype)
REDIS_URL=
PERSIST_DEBOUNCE_MS=500
SNAPSHOT_EVERY=200
MAX_FILE_BYTES=1048576
