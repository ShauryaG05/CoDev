# ==============================================================================
# CoDev Environment Variables
# ==============================================================================

# Server Port
PORT=4000

# Client Application URL (for CORS and redirects)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/codev
# For MongoDB Atlas (replace <username>, <password>, and <cluster>):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codev?retryWrites=true&w=majority

# JWT Secrets for Authentication (replace with strong secret keys in production)
JWT_SECRET=codev_jwt_access_secret_dev_key_2026_xyz
JWT_REFRESH_SECRET=codev_jwt_refresh_secret_dev_key_2026_xyz
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional Redis URL (leave blank to run in-memory for single-node prototype)
REDIS_URL=

# Yjs Persistence Configuration
PERSIST_DEBOUNCE_MS=500
SNAPSHOT_EVERY=200
MAX_FILE_BYTES=1048576
